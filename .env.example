# Trade Model V1 deployment environment template.
# Copy to .env and replace every placeholder before running Docker Compose.
# Do not commit .env or real secrets.

# App binding. Compose binds the host port to localhost by default.
SPRING_PROFILES_ACTIVE=
APP_PORT=
APP_BIND_ADDRESS=
SERVER_ADDRESS=
TRADE_MODEL_PRODUCTION_ALLOW_PUBLIC_BIND=
TRADE_MODEL_INITIAL_USERNAME=
# Required: inject a strong password through the approved secret store or an untracked .env.
# No fixed password placeholder is provided because template values are rejected by startup guards.
TRADE_MODEL_INITIAL_PASSWORD=

# Form-login/Session/CSRF smoke inputs. Keep values runtime-only and never
# commit a populated copy. The optional CA path is for an approved private CA.
TRADE_MODEL_SMOKE_USERNAME=
TRADE_MODEL_SMOKE_PASSWORD=
TRADE_MODEL_SMOKE_CA_CERT=

# PostgreSQL service and Spring prod datasource.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PROD_DATASOURCE_URL=
PROD_DATASOURCE_USERNAME=
PROD_DATASOURCE_PASSWORD=

# Backup / restore script inputs. Use deployment secrets, not hard-coded credentials.
BACKUP_DIR=
PROD_DATASOURCE_HOST=
PROD_DATASOURCE_PORT=
PROD_DATASOURCE_DATABASE=
RESTORE_DATASOURCE_HOST=
RESTORE_DATASOURCE_PORT=
RESTORE_DATASOURCE_DATABASE=
RESTORE_DATASOURCE_USERNAME=
RESTORE_DATASOURCE_PASSWORD=
RESTORE_BACKUP_FILE=
RESTORE_CONFIRM=

# Position provider / Binance readonly position source required by prod guard.
POSITION_PROVIDER_TYPE=
BINANCE_API_BASE_URL=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI providers are disabled by default; fill keys only when explicitly enabling them.
TRADE_MODEL_AI_ENABLED=
TRADE_MODEL_AI_OPENAI_ENABLED=
OPENAI_API_KEY=
TRADE_MODEL_AI_GEMINI_ENABLED=
GEMINI_API_KEY=
TRADE_MODEL_AI_XAI_ENABLED=
XAI_API_KEY=

# External context providers are optional and readonly. They are config-only until a verified fetch source exists.
NEWS_API_KEY=
MACRO_CALENDAR_API_KEY=
ETF_FLOW_API_KEY=

# CoinGlass is disabled unless both switches are explicitly enabled. When enabled, key and RPM are required.
TRADE_MODEL_COINGLASS_ENABLED=
TRADE_MODEL_COINGLASS_EXTERNAL_CALLS_ENABLED=
COINGLASS_API_KEY=
COINGLASS_ADVERTISED_RPM=

# Smoke checks do not call live external providers by default.
SMOKE_ALLOW_EXTERNAL_CALLS=

# Provider live smoke is opt-in. Defaults never call live external providers.
PROVIDER_SMOKE_ENABLE_EXTERNAL_CALLS=
PROVIDER_SMOKE_BINANCE_PUBLIC_ENABLED=
PROVIDER_SMOKE_OPENAI_ENABLED=
PROVIDER_SMOKE_GEMINI_ENABLED=
PROVIDER_SMOKE_XAI_ENABLED=

# Production release gate evidence runner. These do not deploy, restore, or call external providers by default.
RELEASE_GATE_REQUIRE_DOCKER=
RELEASE_GATE_REQUIRE_BACKUP=
RELEASE_GATE_ALLOW_EXTERNAL_CALLS=
RELEASE_GATE_REQUIRE_PROVIDER_SMOKE=

# Telegram is not active in V1 deployment skeleton. Future-use placeholders only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety boundary: no order, execution, auto-open, auto-close, or auto-trading env is supported.
