# Trade Model V1 deployment environment template.
# Copy to .env and replace every change-me placeholder before running Docker Compose.
# Do not commit .env or real secrets.

# App binding. Compose binds the host port to localhost by default.
SPRING_PROFILES_ACTIVE=prod
APP_PORT=8081
APP_BIND_ADDRESS=127.0.0.1
SERVER_ADDRESS=0.0.0.0
TRADE_MODEL_PRODUCTION_ALLOW_PUBLIC_BIND=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# PostgreSQL service and Spring prod datasource.
POSTGRES_DB=trade_model
POSTGRES_USER=trade_model
POSTGRES_PASSWORD=change-me
PROD_DATASOURCE_URL=jdbc:postgresql://postgres:5432/trade_model
PROD_DATASOURCE_USERNAME=trade_model
PROD_DATASOURCE_PASSWORD=change-me

# Backup / restore script inputs. Use deployment secrets, not hard-coded credentials.
BACKUP_DIR=./backups
PROD_DATASOURCE_HOST=localhost
PROD_DATASOURCE_PORT=5432
PROD_DATASOURCE_DATABASE=trade_model
RESTORE_DATASOURCE_HOST=localhost
RESTORE_DATASOURCE_PORT=5432
RESTORE_DATASOURCE_DATABASE=trade_model_restore
RESTORE_DATASOURCE_USERNAME=trade_model
RESTORE_DATASOURCE_PASSWORD=change-me
RESTORE_BACKUP_FILE=./backups/trade_model_v1_YYYYMMDD_HHMMSS.dump
RESTORE_CONFIRM=

# Position provider / Binance readonly position source required by prod guard.
POSITION_PROVIDER_TYPE=BINANCE
BINANCE_API_BASE_URL=https://fapi.binance.com
BINANCE_API_KEY=change-me
BINANCE_API_SECRET=change-me

# AI providers are disabled by default; fill keys only when explicitly enabling them.
TRADE_MODEL_AI_ENABLED=false
TRADE_MODEL_AI_OPENAI_ENABLED=false
OPENAI_API_KEY=
TRADE_MODEL_AI_GEMINI_ENABLED=false
GEMINI_API_KEY=
TRADE_MODEL_AI_XAI_ENABLED=false
XAI_API_KEY=

# External context providers are optional and readonly. They are config-only until a verified fetch source exists.
NEWS_API_KEY=
MACRO_CALENDAR_API_KEY=
ETF_FLOW_API_KEY=

# Smoke checks do not call live external providers by default.
SMOKE_ALLOW_EXTERNAL_CALLS=false

# Provider live smoke is opt-in. Defaults never call live external providers.
PROVIDER_SMOKE_ENABLE_EXTERNAL_CALLS=false
PROVIDER_SMOKE_BINANCE_PUBLIC_ENABLED=false
PROVIDER_SMOKE_OPENAI_ENABLED=false
PROVIDER_SMOKE_GEMINI_ENABLED=false
PROVIDER_SMOKE_XAI_ENABLED=false

# Production release gate evidence runner. These do not deploy, restore, or call external providers by default.
RELEASE_GATE_REQUIRE_DOCKER=true
RELEASE_GATE_REQUIRE_BACKUP=false
RELEASE_GATE_ALLOW_EXTERNAL_CALLS=false
RELEASE_GATE_REQUIRE_PROVIDER_SMOKE=false

# Telegram is not active in V1 deployment skeleton. Future-use placeholders only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety boundary: no order, execution, auto-open, auto-close, or auto-trading env is supported.
