# Non-secret identity document. Fill from independently reviewed external-base evidence.
# Never source this file. Placeholders intentionally fail closed; never hash a credential.
MANIFEST_KIND=NATIVE_SYSTEMD_JAR_RUNTIME
TARGET_ARCH=x86_64
SERVICE_NAME=rine-logic.service
APP_JAR=/opt/rine-logic/current/app.jar
APP_JAR_SHA256=REPLACE_JAR_SHA256
MAIN_UNIT=/etc/systemd/system/rine-logic.service
MAIN_UNIT_SHA256=REPLACE_MAIN_UNIT_SHA256
SCHEDULER_DROPIN=/etc/systemd/system/rine-logic.service.d/20-core-loop-schedulers.conf
SCHEDULER_DROPIN_SHA256=REPLACE_SCHEDULER_SHA256
READY_SCRIPT=/usr/local/sbin/rine-logic-wait-ready
READY_SCRIPT_SHA256=REPLACE_READY_SHA256
RELEASE_METADATA=/opt/rine-logic/current/deployment-metadata.txt
RELEASE_METADATA_FORMAT=REPLACE_RELEASE_METADATA_FORMAT
RELEASE_METADATA_SHA256=REPLACE_RELEASE_METADATA_SHA256
MODEL_ROOT=/opt/rine-logic/models/asset-card
CARD_DROPIN=/etc/systemd/system/rine-logic.service.d/40-asset-card.conf
CREDENTIAL_SOURCE=/etc/rine-logic/credentials/asset-card-db-password
CREDENTIAL_ID=asset-card-db-password
ROOT_UID=REPLACE_ROOT_UID
SERVICE_UID=REPLACE_SERVICE_UID
SERVICE_GID=REPLACE_SERVICE_GID
WRITER_JDBC_URL=REPLACE_NON_SECRET_JDBC_URL
EXPECTED_DATABASE=REPLACE_DATABASE_NAME
WRITER_ROLE=rine_asset_card_writer
MODEL_MODE=SHADOW
PRODUCTION_MODEL_READY=NO
# Optional single authenticated account, selected from verified Session identity.
# Visibility only: does not activate models or grant a collection window.
OWNER_PREVIEW_USER_ID=NONE
# PREPARED keeps all card switches off. ARMED is a separately approved, fixed allowance.
CARD_STARTUP_MODE=PREPARED
COLLECTION_WINDOW_ID=NOT_CONFIGURED
COLLECTION_STARTS_AT=NOT_CONFIGURED
COLLECTION_ENDS_AT=NOT_CONFIGURED
COLLECTION_SYMBOLS=NONE
COLLECTION_STATE_DIRECTORY=/var/lib/rine-logic-asset-card/collection
ARCHIVE_DIRECTORY=/var/lib/rine-logic-asset-card/archive
SHARED_IP_WEIGHT_ALLOWANCE_PER_MINUTE=0
SHARED_IP_WEIGHT_LIMIT_PER_MINUTE=0
SHARED_IP_HEADROOM_CONFIRMED_AT=NOT_CONFIGURED
MAXIMUM_REST_REQUESTS=288
MAXIMUM_REST_WEIGHT=72000
MAXIMUM_CONNECTION_ATTEMPTS=32
MAXIMUM_CONTROL_MESSAGES=128
MAXIMUM_NEW_ROWS=1100000
MAXIMUM_DATABASE_GROWTH_BYTES=3221225472
MAXIMUM_WAL_GROWTH_BYTES=8589934592
MINIMUM_FREE_BYTES=21474836480
# Reviewed declaration, not a substitute for measuring the real PostgreSQL data filesystem.
STORAGE_SAME_FILESYSTEM_VERIFIED=NO
DATABASE_FILESYSTEM_DEVICE=NOT_VERIFIED
