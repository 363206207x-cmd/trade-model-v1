[Unit]
Description=P3-H LAB1 seal runtime credentials read-only
Requires=p3h-lab-credential-holder.service
After=p3h-lab-credential-holder.service
Before=trade-model-p3h.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mount -t tmpfs -o remount,ro,nodev,nosuid,noexec tmpfs /run/credentials/p3hlab1
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
