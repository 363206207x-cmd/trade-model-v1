[Unit]
Description=P3-H LAB1 shared runtime-only credential mount
Before=p3h-lab-credential-holder.service

[Mount]
What=tmpfs
Where=/run/credentials/p3hlab1
Type=tmpfs
Options=mode=0700,uid=RENDER_DEPLOYMENT_UID,gid=RENDER_DEPLOYMENT_GID,size=1m,nodev,nosuid,noexec

[Install]
WantedBy=multi-user.target
