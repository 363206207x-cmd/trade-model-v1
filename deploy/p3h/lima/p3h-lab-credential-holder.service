[Unit]
Description=P3-H LAB1 runtime-only credential holder
RequiresMountsFor=/run/credentials/p3hlab1
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=p3h-deploy
Group=p3h-deploy
LoadCredentialEncrypted=postgres_admin_password:/etc/credstore.encrypted/trade-model-p3h/postgres_admin_password.cred
LoadCredentialEncrypted=flyway_password:/etc/credstore.encrypted/trade-model-p3h/flyway_password.cred
LoadCredentialEncrypted=app_database_password_v1:/etc/credstore.encrypted/trade-model-p3h/app_database_password_v1.cred
LoadCredentialEncrypted=app_database_password_v2:/etc/credstore.encrypted/trade-model-p3h/app_database_password_v2.cred
LoadCredentialEncrypted=app_admin_password_v1:/etc/credstore.encrypted/trade-model-p3h/app_admin_password_v1.cred
LoadCredentialEncrypted=app_admin_password_v2:/etc/credstore.encrypted/trade-model-p3h/app_admin_password_v2.cred
LoadCredentialEncrypted=backup_reader_password:/etc/credstore.encrypted/trade-model-p3h/backup_reader_password.cred
LoadCredentialEncrypted=recovery_owner_password:/etc/credstore.encrypted/trade-model-p3h/recovery_owner_password.cred
LoadCredentialEncrypted=binance_nonfunctional_key:/etc/credstore.encrypted/trade-model-p3h/binance_nonfunctional_key.cred
LoadCredentialEncrypted=binance_nonfunctional_secret:/etc/credstore.encrypted/trade-model-p3h/binance_nonfunctional_secret.cred
LoadCredentialEncrypted=tls_certificate:/etc/credstore.encrypted/trade-model-p3h/tls_certificate_v1.cred
LoadCredentialEncrypted=tls_private_key:/etc/credstore.encrypted/trade-model-p3h/tls_private_key_v1.cred
LoadCredentialEncrypted=tls_ca_certificate:/etc/credstore.encrypted/trade-model-p3h/tls_ca_certificate.cred
LoadCredentialEncrypted=tls_certificate_v2:/etc/credstore.encrypted/trade-model-p3h/tls_certificate_v2.cred
LoadCredentialEncrypted=tls_private_key_v2:/etc/credstore.encrypted/trade-model-p3h/tls_private_key_v2.cred
ExecStart=/usr/local/libexec/p3h-lab-materialize-credentials.sh
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
