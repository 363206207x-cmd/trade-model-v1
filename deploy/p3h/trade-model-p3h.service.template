[Unit]
Description=Trade Model controlled P3-H staging stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=p3h-deploy
Group=p3h-deploy
WorkingDirectory=/opt/trade-model-p3h/current
RuntimeDirectory=trade-model-p3h
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
Environment=P3H_APPLICATION_IMAGE_TAG=RENDER_EXACT_HEAD_PREFIX
Environment=P3H_STAGING_HOSTNAME=RENDER_APPROVED_STAGING_HOSTNAME
Environment=P3H_SECRET_BACKEND=SYSTEMD_CREDENTIALS
Environment=P3H_START_MODE=RENDER_INITIALIZE_GREENFIELD_RECOVER_GREENFIELD_OR_STEADY_STATE_START
Environment=P3H_GREENFIELD_INITIALIZE_CONFIRM=RENDER_EMPTY_FOR_STEADY_OR_EXPLICIT_CONFIRMATION
Environment=P3H_GREENFIELD_RECOVERY_CONFIRM=RENDER_EMPTY_UNLESS_EXPLICIT_RECOVERY_CONFIRMATION
Environment=P3H_ACTIVE_APP_DATABASE_SECRET_VERSION=RENDER_V1_OR_V2
Environment=P3H_ACTIVE_APP_ADMIN_SECRET_VERSION=RENDER_V1_OR_V2
LoadCredentialEncrypted=postgres_admin_password:RENDER_CREDENTIAL_POSTGRES_ADMIN_PASSWORD
LoadCredentialEncrypted=flyway_password:RENDER_CREDENTIAL_FLYWAY_PASSWORD
LoadCredentialEncrypted=app_database_password_v1:RENDER_CREDENTIAL_APP_DATABASE_PASSWORD_V1
LoadCredentialEncrypted=app_database_password_v2:RENDER_CREDENTIAL_APP_DATABASE_PASSWORD_V2
LoadCredentialEncrypted=app_admin_password_v1:RENDER_CREDENTIAL_APP_ADMIN_PASSWORD_V1
LoadCredentialEncrypted=app_admin_password_v2:RENDER_CREDENTIAL_APP_ADMIN_PASSWORD_V2
LoadCredentialEncrypted=backup_reader_password:RENDER_CREDENTIAL_BACKUP_READER_PASSWORD
LoadCredentialEncrypted=recovery_owner_password:RENDER_CREDENTIAL_RECOVERY_OWNER_PASSWORD
LoadCredentialEncrypted=binance_nonfunctional_key:RENDER_CREDENTIAL_BINANCE_NONFUNCTIONAL_KEY
LoadCredentialEncrypted=binance_nonfunctional_secret:RENDER_CREDENTIAL_BINANCE_NONFUNCTIONAL_SECRET
LoadCredentialEncrypted=tls_certificate:RENDER_CREDENTIAL_TLS_CERTIFICATE
LoadCredentialEncrypted=tls_private_key:RENDER_CREDENTIAL_TLS_PRIVATE_KEY
ExecStart=/opt/trade-model-p3h/current/deploy/p3h/p3h-systemd-credentials-adapter.sh
ExecStop=/opt/trade-model-p3h/current/deploy/p3h/p3h-compose-stop.sh
TimeoutStartSec=360
TimeoutStopSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
